DEEPSEEK_API_KEY=sk-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-v4-pro (Pro) or deepseek-flash (V4.1 Flash, cheaper)
DEEPSEEK_MODEL=deepseek-v4-pro
MUSAB_DB=data/musab.db
# Max agent-to-agent replies in one thread before they stop (cost/loop guard)
MUSAB_MAX_HOPS=6
MUSAB_POLL_SECONDS=2
MUSAB_MAX_TOOL_STEPS=8
